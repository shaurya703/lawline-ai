GEMINI_API_KEY=
GROQ_API_KEY=
# LAWLINE_GEMINI_MODEL=gemini-3.5-flash-lite
# LAWLINE_JUDGE_MODEL=gemini-3.6-flash

# Serving limits (the defaults are shown)
# LAWLINE_LLM_TIMEOUT_S=60          # one HTTP call to a model
# LAWLINE_LLM_MAX_WAIT_S=60         # how long a request may wait out rate limits before the API answers 503
# LAWLINE_LLM_PER_MIN=60            # model-backed requests a minute per client; 0 = no limit
# LAWLINE_LLM_GLOBAL_PER_MIN=180    # and for all clients together
# LAWLINE_TRUST_PROXY=1             # read the client address from X-Forwarded-For; only behind a proxy that sets it

# Assets fetched by lawline.bootstrap: a tag or commit of the assets dataset (v1 = the smaller first corpus)
# LAWLINE_ASSETS_REVISION=v1
